# FinSight FinGPT API — copy to .env and fill in values

# OpenRouter inference (required for /ask answers)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional:
# OPENROUTER_TIMEOUT_SECONDS=120
# OPENROUTER_HTTP_REFERER=https://your-frontend.example
# OPENROUTER_APP_TITLE=FinSight

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_MINUTES=10080
GOOGLE_CLIENT_ID=

# Firecrawl — scrape public URLs into the RAG corpus (POST /ingest/url)
FIRECRAWL_API_KEY=
# Optional overrides:
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
# FIRECRAWL_TIMEOUT_SECONDS=90
# FIRECRAWL_MAX_CHARS=120000

# CORS (comma-separated). Defaults include localhost:5173 and the Vercel app.
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://finsight-ai-ebon.vercel.app

# Storage
# CHROMA_PERSIST_DIR=data/chroma
# CHROMA_COLLECTION=finance
# FINSIGHT_SQLITE_PATH=finsight_users.db

# Embeddings
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# PRELOAD_EMBEDDING_MODEL=false
# LOG_LEVEL=INFO
