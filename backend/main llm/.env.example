# Hugging Face Inference API (required for /ask RAG answers)
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional; defaults to google/gemma-3-27b-it
HF_MODEL=google/gemma-3-27b-it

# Auth (required in production)
# JWT_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated frontend origins (required when frontend is on another host)
# CORS_ALLOW_ORIGINS=https://finsight-ai-ebon.vercel.app,http://localhost:5173

# Hugging Face Spaces / Docker (defaults shown)
# HOST=0.0.0.0
# PORT=7860
# CHROMA_PERSIST_DIR=/data/chroma
# FINSIGHT_SQLITE_PATH=/data/finsight_users.db
# PRELOAD_EMBEDDING_MODEL=true

# Optional: seconds for HF Inference HTTP client (default 120)
# HF_INFERENCE_TIMEOUT_SECONDS=120

# Optional: huggingface_hub routing (default auto)
# HF_INFERENCE_PROVIDER=auto

# Optional: root log level (INFO, DEBUG, WARNING)
# LOG_LEVEL=INFO
